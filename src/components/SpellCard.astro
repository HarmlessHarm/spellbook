---
import type { CollectionEntry } from 'astro:content';

interface Props {
  skill: CollectionEntry<'skills'>;
}

const { skill } = Astro.props;
const { name, title, description, category, tags = [] } = skill.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/spells/${name}/`;
const installCmd = `/plugin install ${name}@spellbook`;
---

<article
  class={`card ${category}`}
  data-category={category}
  data-search={`${title} ${description} ${tags.join(' ')} ${category}`.toLowerCase()}
>
  <span class="corner tl"></span>
  <span class="corner tr"></span>
  <span class="corner bl"></span>
  <span class="corner br"></span>
  <a href={href} class="card-link">
    <div class="srow">
      <span class="school">{category}</span>
    </div>
    <h3>{title}</h3>
    <p class="desc">{description}</p>
    <div class="tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </a>
  <button class="cast" type="button" data-cmd={installCmd}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"/>
    </svg>
    Cast — copy install
  </button>
</article>

<style>
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    outline: none;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cast[data-cmd]').forEach(btn => {
    btn.addEventListener('click', () => {
      const cmd = btn.dataset.cmd ?? '';
      navigator.clipboard?.writeText(cmd);
      btn.classList.add('done', 'pulse');
      btn.innerHTML = '✦ Copied to your hand';
      setTimeout(() => {
        btn.classList.remove('done', 'pulse');
        btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg> Cast — copy install`;
      }, 1500);
    });
  });
</script>
