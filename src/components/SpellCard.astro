---
import type { MergedSpell } from '../lib/spells';
import { installCommand } from '../lib/install';

interface Props {
  spell: MergedSpell;
}

const { spell } = Astro.props;
const { name, title, description, type, category, version, tags = [], entrypoint } = spell;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/spells/${name}/`;
const cmd = installCommand({ type, name, entrypoint });
---

<article
  class={`card ${category}`}
  data-category={category}
  data-type={type}
  data-search={`${title} ${description} ${tags.join(' ')} ${category} ${type}`.toLowerCase()}
>
  <span class="corner tl"></span>
  <span class="corner tr"></span>
  <span class="corner bl"></span>
  <span class="corner br"></span>
  <a href={href} class="card-link">
    <div class="srow">
      <span class="school">{category}</span>
      <span class="type-badge">{type}</span>
    </div>
    <h3>{title}</h3>
    <p class="version">v{version}</p>
    <p class="desc">{description}</p>
    <div class="tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </a>
  <button class="cast js-copy" type="button" data-cmd={cmd}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"/>
    </svg>
    Cast — copy install
  </button>
</article>

<style>
  .card-link {
    display: block;
    flex: 1 1 auto;
    text-decoration: none;
    color: inherit;
    outline: none;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--ember);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
