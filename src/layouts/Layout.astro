---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'The Spell Book — Cast a spell on your workflow',
  description = 'The Spell Book — a Claude Code plugin marketplace of skills, commands, and tools to supercharge your AI agent workflows.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,500;0,600;1,500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>
<header class="bar">
  <div class="bar-in">
    <a href={base} class="brand">
      <svg class="seal" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="1.3"/>
        <polygon points="20,7 30.4,26 9.6,26" fill="none" stroke="currentColor" stroke-width="1"/>
        <polygon points="20,33 9.6,14 30.4,14" fill="none" stroke="currentColor" stroke-width="1"/>
      </svg>
      The Spell Book
    </a>
    <nav>
      <a href={`${base}#grimoire`} class="label">The grimoire</a>
      <a href="https://github.com/harmlessharm/spellbook" class="gh label" target="_blank" rel="noopener">GitHub ↗</a>
    </nav>
  </div>
</header>

<div class="wrap">
  <slot />

  <footer>
    <a href="https://github.com/harmlessharm/spellbook" target="_blank" rel="noopener">GitHub</a>
    <span class="dot">✦</span>
    <a href="https://agentskills.io" target="_blank" rel="noopener">SKILL.md spec</a>
    <span class="dot">✦</span>
    <span>Your spells. Your rules.</span>
  </footer>
</div>
</body>
</html>

<style is:global>
  :root {
    --surface: #131315;
    --surface-lowest: #0e0e10;
    --surface-low: #1b1b1d;
    --surface-container: #1f1f21;
    --surface-high: #2a2a2c;
    --on-surface: #e5e1e4;
    --on-surface-variant: #d8c3ad;
    --outline: #a08e7a;
    --outline-variant: #534434;
    --primary: #ffc174;
    --ember: #f59e0b;
    --midnight: #16161a;
    --faded-ink: #a1a1aa;
    --vellum: #dcd2b9;
    --mana: #d3bbff;
    --arcane: #b8c4ff;

    --sage: "EB Garamond", Georgia, serif;
    --scribe: "Plus Jakarta Sans", system-ui, sans-serif;
    --alchemist: "Space Mono", ui-monospace, monospace;

    --gutter: 24px;
    --max: 1280px;
    --ember-glow: rgba(245, 158, 11, 0.2);
  }

  * { box-sizing: border-box }
  html { scroll-behavior: smooth }

  body {
    margin: 0;
    background: var(--midnight);
    color: var(--on-surface);
    font-family: var(--scribe);
    font-size: 16px;
    line-height: 24px;
    position: relative;
    overflow-x: hidden;
    min-height: 100vh;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(900px 520px at 50% -8%, rgba(245, 158, 11, 0.10), transparent 60%),
      radial-gradient(700px 600px at 100% 20%, rgba(211, 187, 255, 0.06), transparent 55%),
      radial-gradient(700px 600px at 0% 40%, rgba(184, 196, 255, 0.05), transparent 55%),
      var(--midnight);
  }

  body::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.04;
    background-image: repeating-linear-gradient(135deg, #fff 0 1px, transparent 1px 7px);
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 16px;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .wrap { padding: 0 64px }
  }

  a { color: inherit }

  .label {
    font-family: var(--alchemist);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ---- header ---- */
  header.bar {
    position: sticky;
    top: 0;
    z-index: 30;
    backdrop-filter: blur(18px);
    background: rgba(19, 19, 21, 0.8);
    border-bottom: 1px solid rgba(160, 142, 122, 0.14);
  }

  .bar-in {
    max-width: var(--max);
    margin: 0 auto;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 768px) {
    .bar-in { padding: 14px 64px }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--sage);
    font-weight: 600;
    font-size: 20px;
    text-decoration: none;
    color: var(--on-surface);
  }

  .brand .seal {
    width: 26px;
    height: 26px;
    color: var(--ember);
    filter: drop-shadow(0 0 6px var(--ember-glow));
  }

  .bar nav { display: flex; gap: 1.4rem; align-items: center }
  .bar nav a { color: var(--faded-ink); text-decoration: none }
  .bar nav a.label:hover { color: var(--on-surface) }
  .bar nav a.gh { color: var(--on-surface-variant) }

  /* ---- scroll (copy command box) ---- */
  .scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    background: var(--surface-lowest);
    border: 1px solid var(--outline-variant);
    border-radius: 2px;
    padding: 0.55rem 0.55rem 0.55rem 0.9rem;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.55);
  }

  .scroll code {
    font-family: var(--alchemist);
    font-size: 13px;
    color: var(--on-surface-variant);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .scroll code .sigil-prompt { color: var(--ember); margin-right: 0.5rem }

  .scroll .conjure {
    flex: none;
    font-family: var(--alchemist);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--primary);
    color: #472a00;
    border: 0;
    border-radius: 2px;
    padding: 0.45rem 0.7rem;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .scroll .conjure:hover { box-shadow: 0 0 0 1px var(--ember), 0 0 16px var(--ember-glow) }

  .scroll .conjure.pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 2px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.7), transparent 60%);
    animation: mana 0.7s ease-out;
  }

  @keyframes mana {
    from { transform: scale(0); opacity: 0.9 }
    to { transform: scale(3); opacity: 0 }
  }

  /* ---- divider ---- */
  .div {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--outline-variant);
    margin: 32px auto 8px;
  }

  .div::before, .div::after {
    content: "";
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, transparent, rgba(160, 142, 122, 0.3), transparent);
  }

  .div svg { width: 18px; height: 18px; color: var(--ember) }

  /* ---- grimoire controls ---- */
  .controls {
    display: flex;
    gap: var(--gutter);
    flex-wrap: wrap;
    align-items: center;
    padding-top: 24px;
  }

  .seek {
    flex: 1 1 260px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--surface-low);
    border: 1px solid rgba(160, 142, 122, 0.2);
    border-radius: 9999px;
    padding: 0.6rem 1rem;
  }

  .seek svg { width: 17px; height: 17px; color: var(--faded-ink); flex: none }

  .seek input {
    flex: 1;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--on-surface);
    font-family: var(--scribe);
    font-size: 15px;
  }

  .seek input::placeholder { color: var(--faded-ink) }
  .seek:focus-within { border-color: var(--ember); box-shadow: 0 0 0 3px var(--ember-glow) }

  .seek kbd {
    font-family: var(--alchemist);
    font-size: 11px;
    color: var(--faded-ink);
    border: 1px solid rgba(160, 142, 122, 0.3);
    border-radius: 4px;
    padding: 0.05rem 0.4rem;
  }

  .categories { display: flex; gap: 0.5rem; flex-wrap: wrap }

  .chip {
    font-family: var(--alchemist);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: transparent;
    border: 1px solid rgba(160, 142, 122, 0.3);
    color: var(--faded-ink);
    border-radius: 9999px;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .chip:hover { color: var(--on-surface) }
  .chip[aria-pressed="true"] { border-color: var(--primary); color: var(--primary) }
  .chip[data-cat="all"][aria-pressed="true"] { border-color: var(--ember); color: var(--primary) }
  .chip[data-cat="git"][aria-pressed="true"] { border-color: var(--ember); color: var(--ember) }
  .chip[data-cat="debugging"][aria-pressed="true"] { border-color: var(--mana); color: var(--mana) }
  .chip[data-cat="testing"][aria-pressed="true"] { border-color: var(--arcane); color: var(--arcane) }

  .count {
    font-family: var(--alchemist);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--faded-ink);
    margin: 22px 0 24px;
  }

  /* ---- card grid ---- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--gutter);
    padding-bottom: 96px;
  }

  .card {
    position: relative;
    background: var(--surface-low);
    border-radius: 2px;
    padding: 24px;
    transition: transform 0.25s ease;
    display: flex;
    flex-direction: column;
  }

  .card .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--outline-variant);
    transition: border-color 0.25s;
  }

  .corner.tl { top: 0; left: 0; border-right: 0; border-bottom: 0 }
  .corner.tr { top: 0; right: 0; border-left: 0; border-bottom: 0 }
  .corner.bl { bottom: 0; left: 0; border-right: 0; border-top: 0 }
  .corner.br { bottom: 0; right: 0; border-left: 0; border-top: 0 }

  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 2px;
    pointer-events: none;
    opacity: 0.05;
    background-image: repeating-linear-gradient(135deg, #fff 0 1px, transparent 1px 6px);
  }

  .card:hover { transform: translateY(-4px) }
  .card:hover .corner { border-color: var(--primary) }
  .card.git:hover .corner { border-color: var(--ember) }
  .card.debugging:hover .corner { border-color: var(--mana) }
  .card.testing:hover .corner { border-color: var(--arcane) }

  .srow { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.85rem }

  .school {
    font-family: var(--alchemist);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .git .school { color: var(--ember) }
  .debugging .school { color: var(--mana) }
  .testing .school { color: var(--arcane) }

  /* ---- type badge + version ---- */
  .type-badge {
    font-family: var(--alchemist);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    padding: 0.1rem 0.4rem;
    background: rgba(160, 142, 122, 0.15);
    color: var(--faded-ink);
    margin-left: auto;
  }

  [data-type="skill"] .type-badge { background: rgba(245, 158, 11, 0.15); color: var(--ember) }
  [data-type="command"] .type-badge { background: rgba(211, 187, 255, 0.18); color: var(--mana) }
  [data-type="tool"] .type-badge { background: rgba(134, 239, 172, 0.15); color: #86efac }

  .version {
    font-family: var(--alchemist);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--faded-ink);
    opacity: 0.55;
    margin: 0.1rem 0 0.6rem;
  }

  .card h3 {
    font-family: var(--sage);
    font-weight: 500;
    font-size: 24px;
    line-height: 32px;
    margin: 0 0 0.5rem;
  }

  .card .desc {
    font-family: var(--scribe);
    font-style: italic;
    font-size: 14px;
    line-height: 20px;
    color: var(--faded-ink);
    margin: 0 0 1.1rem;
    min-height: 3.3em;
  }

  .tags { display: flex; gap: 0.55rem; flex-wrap: wrap; margin-bottom: 1.2rem }

  .tag {
    font-family: var(--alchemist);
    font-size: 11px;
    color: var(--faded-ink);
    letter-spacing: 0.04em;
  }

  .tag::before { content: "//"; margin-right: 0.35rem; opacity: 0.4 }

  .cast {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid rgba(160, 142, 122, 0.3);
    color: var(--on-surface);
    border-radius: 3px;
    padding: 0.7rem;
    font-family: var(--alchemist);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
    margin-top: auto;
  }

  .cast svg { width: 14px; height: 14px }
  .cast:hover { border-color: var(--ember); color: var(--primary); box-shadow: inset 0 0 24px var(--ember-glow) }
  .cast.done { border-color: var(--ember); color: var(--primary) }

  .cast.pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.5), transparent 60%);
    animation: mana 0.7s ease-out;
  }

  .empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 72px 0;
    font-family: var(--sage);
    font-style: italic;
    font-size: 24px;
    color: var(--faded-ink);
  }

  /* ---- spell detail page ---- */
  #spell-page { padding: 32px 0 96px }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--alchemist);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faded-ink);
    text-decoration: none;
    margin-bottom: 28px;
  }

  .back:hover { color: var(--primary) }

  .spell-detail { max-width: 760px }

  .spell-detail h1 {
    font-family: var(--sage);
    font-weight: 600;
    font-size: 40px;
    line-height: 48px;
    letter-spacing: -0.02em;
    margin: 0.5rem 0 0.6rem;
  }

  .spell-detail .lede {
    font-family: var(--scribe);
    font-style: italic;
    font-size: 18px;
    line-height: 28px;
    color: var(--on-surface-variant);
    margin: 0 0 1.3rem;
  }

  .spell-detail .scroll { margin: 1.4rem 0 0 }

  .spell-body {
    border-top: 1px solid rgba(160, 142, 122, 0.14);
    margin-top: 2rem;
    padding-top: 1.8rem;
  }

  .spell-body h1 { display: none }

  .spell-body h2 {
    font-family: var(--sage);
    font-weight: 600;
    font-size: 22px;
    line-height: 28px;
    margin: 1.8rem 0 0.7rem;
  }

  .spell-body h2:first-child { margin-top: 0 }

  .spell-body h3 {
    font-family: var(--sage);
    font-weight: 600;
    font-size: 18px;
    margin: 1.3rem 0 0.5rem;
  }

  .spell-body p { color: var(--on-surface-variant); margin: 0 0 1rem }

  .spell-body ol, .spell-body ul {
    color: var(--on-surface-variant);
    padding-left: 1.3rem;
    margin: 0 0 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .spell-body li { line-height: 24px }

  .spell-body code {
    font-family: var(--alchemist);
    font-size: 13px;
    color: var(--primary);
    background: var(--surface-lowest);
    border: 1px solid var(--outline-variant);
    border-radius: 3px;
    padding: 0.05rem 0.35rem;
  }

  /* ---- footer ---- */
  footer {
    border-top: 1px solid rgba(160, 142, 122, 0.14);
    padding: 34px 0 80px;
    display: flex;
    gap: 1.6rem;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    font-family: var(--alchemist);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--faded-ink);
  }

  footer a { color: var(--on-surface-variant); text-decoration: none }
  footer a:hover { color: var(--primary) }
  footer .dot { color: var(--outline-variant) }

  @media (max-width: 600px) {
    .hero { padding: 56px 0 40px }
    .hero h1 { font-size: 32px; line-height: 40px; white-space: normal }
  }

  @media (prefers-reduced-motion: reduce) {
    .sigil [class^="d"] { animation: none; stroke-dashoffset: 0 }
    .pulse::after { animation: none; display: none }
    html { scroll-behavior: auto }
  }
</style>

<script>
  // ---- Copy handlers (global) ----
  document.addEventListener('click', e => {
    const target = e.target;
    if (!(target instanceof Element)) return;

    const copyBtn = target.closest<HTMLElement>('.js-copy');
    if (!copyBtn) return;

    const container = copyBtn.matches('[data-cmd]') ? copyBtn : copyBtn.closest<HTMLElement>('[data-cmd]');
    const cmd = container?.dataset.cmd ?? '';
    if (cmd) navigator.clipboard?.writeText(cmd);

    if (copyBtn.classList.contains('cast')) {
      if (!copyBtn.dataset.originalHtml) copyBtn.dataset.originalHtml = copyBtn.innerHTML;
      copyBtn.classList.add('done', 'pulse');
      copyBtn.innerHTML = '✦ Copied to your hand';
      setTimeout(() => {
        copyBtn.classList.remove('done', 'pulse');
        copyBtn.innerHTML = copyBtn.dataset.originalHtml ?? '';
      }, 1500);
    } else {
      const original = copyBtn.textContent ?? 'Copy';
      copyBtn.textContent = 'Copied';
      copyBtn.classList.add('pulse');
      setTimeout(() => {
        copyBtn.textContent = original;
        copyBtn.classList.remove('pulse');
      }, 1500);
    }
  });
</script>
