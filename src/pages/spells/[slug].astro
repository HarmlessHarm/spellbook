---
import { getSpells } from '../../lib/spells';
import { installCommand } from '../../lib/install';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const spells = await getSpells();
  return spells.map(spell => ({
    params: { slug: spell.name },
    props: { spell },
  }));
}

const { spell } = Astro.props;
const { name, title, description, type, category, version, tags = [], entrypoint, download } = spell;
const cmd = installCommand({ type, name, entrypoint });
const base = import.meta.env.BASE_URL;
const downloadUrl = download ? `${base.replace(/\/$/, '')}/skills/${download}` : null;
const { Content } = spell.bodyEntry ? await render(spell.bodyEntry) : { Content: null };
---

<Layout title={`${title} — The Spell Book`} description={description}>
  <section id="spell-page">
    <a class="back" href={base}>← Back to the grimoire</a>
    <article class={`spell-detail ${category}`}>
      <div class="srow">
        <span class="school">{category}</span>
        <span class="type-badge">{type}</span>
      </div>
      <h1>{title}</h1>
      <p class="version" style="margin: 0.2rem 0 0.8rem">v{version}</p>
      <p class="lede">{description}</p>
      <div class="tags">
        {tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
      <div class="scroll" style="margin-top: 1.4rem" data-cmd={cmd}>
        <code><span class="sigil-prompt">›</span>{cmd}</code>
        <button class="conjure js-copy" type="button">Copy</button>
      </div>
      {downloadUrl && (
        <a class="skill-download" href={downloadUrl} download>
          <span class="skill-download__icon">⇩</span>
          Download .skill bundle
        </a>
      )}
      <div class="spell-body">
        {Content && <Content />}
      </div>
    </article>
  </section>
</Layout>

<style>
  .skill-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.8rem;
    font-family: var(--alchemist);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faded-ink);
    text-decoration: none;
    border: 1px solid var(--outline-variant);
    border-radius: 2px;
    padding: 0.45rem 0.7rem;
    transition: color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .skill-download:hover {
    color: var(--primary);
    border-color: var(--ember);
    box-shadow: 0 0 12px var(--ember-glow);
  }

  .skill-download__icon { font-size: 14px }
</style>
